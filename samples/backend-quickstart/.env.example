# Copy to .env and fill in, then `docker compose up`.

# Your app's secret key, from the portal (Apps → your app → issue a key).
VISUALIZE_SECRET_KEY=sk_test_...

# The signing secret shown once when you set a webhook URL. Leave blank
# until you configure a webhook.
VISUALIZE_WEBHOOK_SECRET=

# The API to talk to. Pilots: use the base URL from your onboarding.
VISUALIZE_API=https://api.visualizeme.ai

# Host port to publish the backend on. Change if 8080 is taken.
HOST_PORT=8080
